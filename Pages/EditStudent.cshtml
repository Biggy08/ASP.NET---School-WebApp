@page
@model Test2.Pages.EditStudentModel
@{
}


<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    rel="stylesheet">
</head>


@*----Edit Student Details form*@
<body>
    <div class="container" style="margin-left: 10rem;">
        <h1>Edit Student</h1>
        <br />

        @*asp-for : sets Existing value in the Input Field *@
        <form method="post" style="max-width: 400px;">
            <input type="hidden" asp-for="Student.Id" />

            <div class="mb-3">
                <label>Name</label>
                <input asp-for="Student.SName" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Score</label>
                <input asp-for="Student.Score" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Course</label>
                <select asp-for="Student.CourseId" asp-items="Model.Courses" class="form-control"></select>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a asp-page="/StudentData" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</body>