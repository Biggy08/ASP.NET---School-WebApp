@page
@model Test2.Pages.NoticeModel
@{
}


<head>
	<title>Notice or Annoucements</title>
	
	@*CSS integration*@
	<link rel="stylesheet" href="~/css/Dashboard.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
		  rel="stylesheet">
</head>

<body>
    <div class="container" style="margin-left: 10rem;">
        <h1>Add Notice</h1>
        <br />

        <form method="post" asp-page-handler="AddNotice" style="max-width: 400px;">

            <div class="mb-3">
                <label>Message</label>
                <textarea asp-for="NewNotice.Message" class="form-control" rows="4"></textarea>
            </div>

            <button type="submit" class="btn btn-dark">Post Notice</button>

        </form>
    </div>
</body>