@page
@model Test2.Pages.StudentDataModel

@{
}

<head>
    <link rel="stylesheet" href="~/css/Dashboard.css" />
    <link rel="stylesheet" href="~/css/simple.css" />

    @*Bootstrap Integration*@
    <link 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    rel="stylesheet" 
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
    crossorigin="anonymous">

</head>

<body>
    @*Mother Div*@
    <div class="container" style="margin-left: 10rem;">
    <section id="StudentDisplay"> 


	<h1 class="title">Students Data</h1>
    <br />
    @*------------Stat cards-----------*@
    <div class="cards">
        <div class="stat-card">
            <p>Total Students</p>
            <h2>@Model.StudentCount</h2>
        </div>

        <div class="stat-card">
            <p>Pass Students</p>
            <h2>@Model.PassCount</h2>
        </div>

        <div class="stat-card">
            <p>Fail Students</p>
            <h2>@Model.FailCount</h2>
        </div>

            <div class="stat-card">
                <p>Fail Students</p>
                <h2>@Model.FailCount</h2>
            </div>
    </div>
        @*------------Stat cards-----------*@


        @*---------------------------------------------------------*@
        <div class="class1">

            @*----Top 5 Table----*@
            <div class="card shadow p-3" style="width: 300px; flex-shrink: 0;">
                <h5 class="mb-3 text-center">Top 5 Students</h5>
                <table class="table table-bordered table-hover table-sm text-center mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Score</th>
                            <th>Course</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.TopStudents.Count; i++)
                        {
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@Model.TopStudents[i].SName</td>
                                <td>@Model.TopStudents[i].Score</td>
                                <td>@(Model.TopStudents[i].Course?.Title ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @*---------------------------------------------------------*@
            @*----Bar Chart----*@
            <div class="charts">
                <canvas id="courseChart" style="max-width: 300px; max-height: 250px;"></canvas>
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <script>
                    new Chart(document.getElementById('courseChart'), {
                    type: 'bar',
                    data: {
                    labels: ['Computer', 'Civil', 'Electrical'],
                    datasets: [{
                    label: 'Students per Course',
                    data: [@Model.ComputerCount, @Model.CivilCount, @Model.ElectricalCount],
                    backgroundColor:[
                        '#222222',
                        '#888888',
                        '#cccccc',
                    ]
                    }]
                    },
                    options: {
                    maintainAspectRatio: false,
                    responsive: true
                    }
                    });
                </script>
            </div>

        @*---------------------------------------------------------*@
        @*Doughnut Chart*@
        <div class="charts">
            <canvas id="doughnutChart" style="max-width: 400px; max-height: 250px;"></canvas>
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script>
                new Chart(document.getElementById('doughnutChart'), {
                type: 'doughnut',                        //only change from 'bar'
                data: {
                labels: ['Computer', 'Civil', 'Electrical'],
                datasets: [{
                label: 'Students per Course',
                data: [@Model.ComputerCount, @Model.CivilCount, @Model.ElectricalCount],
                backgroundColor: [              //doughnuts need slice colors
                '#222222',
                '#888888',
                '#cccccc',
                ]
                }]
                },
                options: {
                maintainAspectRatio: false,
                responsive: true
                }
                });
            </script>
        </div>

        </div>
        @*--------------------------------------------------------*@


    </section>
    @*================================================*@
        @* Manage Students *@
        <hr />
        <section>
            <h1>Manage Students</h1>
            <br />


            
            @* Search Bar *@
            <div class="mb-3" style="max-width: 300px;">
                <input id="searchInput" type="text" class="form-control" style="border-color:black" placeholder=" Search by name..." />
            </div>


            @*--------Student Management Table------*@
            <div class="card shadow p-3" style="max-width: 50vw;">
                <table class="table table-bordered table-hover table-sm text-center mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Score</th>
                            <th>Result</th>
                            <th>Course</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="studentTableBody">   @* important to perform actions*@
                        @foreach (var student in Model.AllStudents)
                        {
                            <tr>
                                <td>@student.Id</td>
                                <td>@student.SName</td>
                                <td>@student.Score</td>
                                <td>@(student.Result ? "Pass" : "Fail")</td>
                                <td>@(student.Course?.Title ?? "N/A")</td>

                                <td>
                                    @*asp-page = Go To this page ,  asp-route-id = Passing student id in the url*@
                                    <div class="d-flex gap-2">
                                        <a asp-page="/EditStudent" asp-route-id="@student.Id" class="btn btn-warning btn-sm">Edit</a>

                                        <form method="post" asp-page-handler="Delete">
                                            <input type="hidden" name="id" value="@student.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </td>
                           
                            </tr>
                        }
                    </tbody>
                </table>
            </div>


            @*Search button script*@
            <script>
                document.getElementById('searchInput').addEventListener('input', function () {
                const search = this.value.toLowerCase();
                const rows = document.querySelectorAll('#studentTableBody tr');

                rows.forEach(row => {
                const name = row.cells[1].textContent.toLowerCase(); // column index 1 = Name
                row.style.display = name.includes(search) ? '' : 'none';
                });
                });
            </script>

        </section>

        @*----------------------------------------------------*@

        @*Add Student*@
        @* Add Student *@
        <hr />
        <section>
            <h1>Add Student</h1>
            <br />

            <form method="post" asp-page-handler="AddStudent" style="max-width: 400px;">

                @*asp-for = Tag Helper : for property binding*@
                <div class="mb-3">
                    <label>Name</label>
                    <input asp-for="NewStudent.SName" @*asp-for = Tag Helper : for property binding*@
                        class="form-control" />       @*Bootstrap*@
                </div>

                <div class="mb-3">
                    <label>Score</label>
                    <input asp-for="NewStudent.Score" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Address</label>
                    <input asp-for="NewStudent.Address" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Contact</label>
                    <input asp-for="NewStudent.Contact" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Course</label>
                    <select asp-for="NewStudent.CourseId" asp-items="Model.Courses" class="form-control"></select>
                </div>

                <button type="submit" class="btn btn-dark px-4 py-2" style="font-size:25px"   >Submit</button>
            </form>

        </section>

        @*----------------------------------------------------*@

        

    @*Mother Div End*@
    </div>
</body>
